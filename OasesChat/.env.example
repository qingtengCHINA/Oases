# Copy this file to OasesChat/.env (gitignored) and fill in your own values.
# The build turns it into OasesChat/Generated/Secrets.swift (also gitignored).
#
# The app talks to an OpenAI-compatible endpoint. Without a key the app still
# builds and runs; model requests just fail until you add one, or until you
# add your own provider in Settings > Advanced > Manage Providers.
API_BASE_URL=https://api.example.com/v1
API_KEY=

# Optional: a separate endpoint for Ogent (engineering mode).
# PROJECT_AI_BASE_URL=
# PROJECT_AI_API_KEY=

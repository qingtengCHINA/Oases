    "This will clear all customizations (including force-enabled thinking) and restore the provider's default values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Anpassungen (einschließlich erzwungenem Denken) gelöscht und die Standardwerte des Anbieters wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear all customizations (including force-enabled thinking) and restore the provider's default values."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les personnalisations (y compris la réflexion forcée) seront effacées et les valeurs par défaut du fournisseur seront rétablies."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのカスタマイズ（強制的にオンにした思考を含む）を消去し、プロバイダのデフォルト値に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사용자 지정 설정(강제로 켠 사고 포함)을 지우고 제공업체의 기본값으로 복원해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены все пользовательские настройки (включая принудительно включённое размышление) и восстановлены значения провайдера по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清除所有自定义设置（包括强制开启的思考），并恢复供应商的默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清除所有自訂設定（包括強制開啟的思考），並恢復供應商的預設值。"
          }
        }
      }
    },
    "This will delete %@ of files. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden Dateien mit %@ gelöscht. Diese Aktion kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete %@ of files. This action cannot be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de fichiers seront supprimés. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 分のファイルを削除します。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 분량의 파일이 삭제돼요. 이 작업은 실행 취소할 수 없어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены файлы объёмом %@. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除 %@ 的文件，此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將刪除 %@ 的檔案，此動作無法復原。"
          }
        }
      }
    },
    "This will delete %@ of log files. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden Protokolldateien mit %@ gelöscht. Diese Aktion kann nicht widerrufen werden."

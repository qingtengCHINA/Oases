    "Stop the running task before clearing the chat." : {
      "comment" : "Chat notice: /clear refused while the agent is running",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppe die laufende Aufgabe, bevor du den Chat leerst."

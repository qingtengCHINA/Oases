          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le runner téléchargé n’est pas un ELF Linux aarch64 exécutable par l’invité iSH actuel. Utilisez une version de llama-server compatible avec iSH/Alpine aarch64."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした runner は、現在の iSH ゲストで実行できる aarch64 Linux ELF ではありません。iSH/Alpine aarch64 に対応した llama-server を使用してください。"

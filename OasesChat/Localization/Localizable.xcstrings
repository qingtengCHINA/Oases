    "Primary" : {
      "comment" : "Default group role badge",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primär"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primary"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メイン"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основная"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要"
          }
        }
      }
    },
    "Primary is used for main agent tasks. Sub is used for lightweight tasks like title generation. Voice Input/Output pick a group whose audio-capable models drive speech-to-text and text-to-speech; if none is set, the offline System voice is used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hauptgruppe wird für die Hauptaufgaben des Agenten verwendet, die Untergruppe für leichte Aufgaben wie das Erzeugen von Titeln. Für Spracheingabe/-ausgabe wählst du eine Gruppe, deren audiofähige Modelle Sprache zu Text und Text zu Sprache übernehmen. Ist keine festgelegt, wird die Offline-Systemstimme verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primary is used for main agent tasks. Sub is used for lightweight tasks like title generation. Voice Input/Output pick a group whose audio-capable models drive speech-to-text and text-to-speech; if none is set, the offline System voice is used."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le groupe principal sert aux tâches principales de l’agent. Le groupe secondaire sert aux tâches légères, comme la génération de titres. Pour l’entrée et la sortie vocales, choisissez un groupe dont les modèles compatibles audio assurent la reconnaissance et la synthèse vocales ; si aucun n’est défini, la voix Système hors ligne est utilisée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メイングループはエージェントのメインタスクに、サブグループはタイトル生成などの軽いタスクに使用されます。音声入力/出力では、音声対応モデルを含むグループを選択すると、そのモデルが音声認識と音声合成を担当します。設定しない場合は、オフラインのシステム音声が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주 그룹은 에이전트의 주요 작업에, 보조 그룹은 제목 생성 같은 가벼운 작업에 사용돼요. 음성 입력/출력은 오디오를 지원하는 모델이 음성-텍스트 변환과 텍스트-음성 변환을 담당할 그룹을 선택해요. 설정하지 않으면 오프라인 시스템 음성을 사용해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основная группа используется для главных задач агента, дополнительная — для лёгких задач, например создания названий. Для голосового ввода и вывода выберите группу, модели с поддержкой аудио из которой будут отвечать за распознавание и синтез речи; если группа не задана, используется офлайн-голос системы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要分组用于 Agent 的主任务，次要分组用于生成标题等轻量任务。语音输入/输出需要选择一个分组，由其中支持音频的模型负责语音转文字和文字转语音；如未设置，则使用离线的系统语音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要分組用於 Agent 的主任務，次要分組用於產生標題等輕量任務。語音輸入/輸出需要選擇一個分組，由其中支援音訊的模型負責語音轉文字和文字轉語音；如未設定，則使用離線的系統語音。"
          }
        }
      }
    },

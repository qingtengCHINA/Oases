    "Auto: tries /v1/images/generations first, falls back to /v1/chat/completions. Caches the working endpoint after the first call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch: Versucht zuerst /v1/images/generations und weicht bei Fehlern auf /v1/chat/completions aus. Der funktionierende Endpunkt wird nach dem ersten Aufruf gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: tries /v1/images/generations first, falls back to /v1/chat/completions. Caches the working endpoint after the first call."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique : essaie d’abord /v1/images/generations, puis se rabat sur /v1/chat/completions en cas d’échec. Le point de terminaison fonctionnel est mis en cache après le premier appel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動：まず /v1/images/generations を試し、失敗した場合は /v1/chat/completions に切り替えます。初回呼び出し後、使用可能なエンドポイントをキャッシュします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동: 먼저 /v1/images/generations를 시도하고, 실패하면 /v1/chat/completions로 전환해요. 첫 호출 후 작동하는 엔드포인트를 캐시해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авто: сначала пробуется /v1/images/generations, при ошибке — /v1/chat/completions. После первого вызова рабочий эндпоинт кэшируется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动：先尝试 /v1/images/generations，失败时回退到 /v1/chat/completions。首次调用后会缓存可用的端点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動：先嘗試 /v1/images/generations，失敗時改用 /v1/chat/completions。首次呼叫後會快取可用的端點。"
          }
        }
      }
    },
    "Auto: tries /v1/images/generations first, falls back to /v1/chat/completions. Last successful endpoint: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch: Versucht zuerst /v1/images/generations und weicht bei Fehlern auf /v1/chat/completions aus. Zuletzt erfolgreicher Endpunkt: %@."
          }
        },
        "en" : {
          "stringUnit" : {

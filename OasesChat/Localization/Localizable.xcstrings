    "Context full. Start a new session to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kontext ist voll. Starte einen neuen Chat, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context full. Start a new session to continue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexte plein. Démarrez une nouvelle conversation pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストがいっぱいです。続けるには新しいチャットを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트가 가득 찼어요. 계속하려면 새 대화를 시작하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контекст заполнен. Начните новый чат, чтобы продолжить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文已满，请开始新会话以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文已滿，請開始新對話以繼續。"
          }
        }
      }
    },
    "Context is full and could not be compacted further. Start a new session or clear the chat to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kontext ist voll und kann nicht weiter komprimiert werden. Starte einen neuen Chat oder leere diesen Chat, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context is full and could not be compacted further. Start a new session or clear the chat to continue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contexte est plein et ne peut plus être compressé. Démarrez une nouvelle conversation ou effacez celle-ci pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストがいっぱいで、これ以上圧縮できません。続けるには新しいチャットを開始するか、チャットを消去してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트가 가득 차서 더 이상 압축할 수 없어요. 계속하려면 새 대화를 시작하거나 대화를 비우세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контекст заполнен, и сжать его сильнее не удалось. Начните новый чат или очистите текущий, чтобы продолжить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文已满且无法进一步压缩。请开始新会话或清空对话后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文已滿且無法進一步壓縮。請開始新對話或清除對話後繼續。"
          }
        }
      }
    },

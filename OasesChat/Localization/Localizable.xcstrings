    "Text input is always enabled. Configure which additional input modalities this model supports." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texteingabe ist immer aktiv. Lege fest, welche weiteren Eingabemodalitäten dieses Modell unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text input is always enabled. Configure which additional input modalities this model supports."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entrée de texte est toujours activée. Configurez les autres modalités d’entrée prises en charge par ce modèle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト入力は常に有効です。このモデルが対応しているその他の入力モダリティを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 입력은 항상 켜져 있어요. 이 모델이 추가로 지원하는 입력 모달리티를 구성하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстовый ввод включён всегда. Укажите, какие ещё модальности ввода поддерживает эта модель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本输入始终开启。请配置此模型还支持哪些输入模态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字輸入永遠開啟。請設定此模型還支援哪些輸入模態。"
          }
        }
      }
    },
    "Text input is always supported. Disable modalities the model doesn't actually support to prevent sending unsupported attachments." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texteingabe wird immer unterstützt. Deaktiviere Modalitäten, die das Modell nicht wirklich unterstützt, damit keine nicht verarbeitbaren Anhänge gesendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text input is always supported. Disable modalities the model doesn't actually support to prevent sending unsupported attachments."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entrée de texte est toujours prise en charge. Désactivez les modalités que le modèle ne prend pas réellement en charge pour éviter d’envoyer des pièces jointes incompatibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト入力は常にサポートされています。対応していない添付ファイルを送信しないよう、モデルが実際には対応していないモダリティをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 입력은 항상 지원돼요. 지원되지 않는 첨부 파일을 보내지 않도록 모델이 실제로 지원하지 않는 모달리티는 끄세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстовый ввод поддерживается всегда. Отключите модальности, которые модель на самом деле не поддерживает, чтобы не отправлять неподдерживаемые вложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本输入始终受支持。关闭模型实际不支持的模态，以免发送无法处理的附件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字輸入永遠受支援。關閉模型實際不支援的模態，以免傳送無法處理的附件。"
          }
        }
      }
    },

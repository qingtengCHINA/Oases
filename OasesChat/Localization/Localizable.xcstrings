    "Sessions are distributed across models. Each session sticks to its assigned model unless it fails." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats werden auf mehrere Modelle verteilt. Jeder Chat bleibt bei seinem zugewiesenen Modell, außer es schlägt fehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions are distributed across models. Each session sticks to its assigned model unless it fails."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversations sont réparties entre les modèles. Chaque conversation conserve le modèle qui lui est attribué, sauf en cas d’échec de celui-ci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットは複数のモデルに振り分けられます。各チャットは、エラーが発生しない限り割り当てられたモデルを使い続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 여러 모델에 분산돼요. 각 대화는 오류가 없는 한 배정된 모델을 계속 사용해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаты распределяются между моделями. Каждый чат использует назначенную модель, пока она не даст сбой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话会分配到不同模型上。每个会话固定使用分配到的模型，除非该模型出错。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對話會分配到不同模型上。每個對話固定使用分配到的模型，除非該模型出錯。"
          }
        }
      }
    },

    "Viewport <%lldpx while UA is Desktop — sites may serve a mobile layout that renders awkwardly. Consider switching UA to Mobile." : {
      "comment" : "Browser settings warning banner; the argument is the width breakpoint in pixels",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viewport schmaler als %lld px, aber UA ist Desktop – Websites liefern evtl. ein mobiles Layout, das seltsam aussieht. Wechsle den UA ggf. zu Mobil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viewport <%lldpx while UA is Desktop — sites may serve a mobile layout that renders awkwardly. Consider switching UA to Mobile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenêtre d’affichage < %lld px alors que le User-Agent est de type ordinateur : les sites risquent de servir une mise en page mobile mal affichée. Envisagez de passer le User-Agent en mode mobile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビューポートの幅が %lldpx 未満ですが UA がデスクトップ版のため、Web サイトが表示の崩れたモバイル版レイアウトを返す可能性があります。UA をモバイル版に切り替えることをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UA가 데스크톱인데 뷰포트가 %lldpx 미만이에요. 웹 사이트가 어색하게 보이는 모바일 레이아웃을 제공할 수 있으니 UA를 모바일로 전환해 보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ширина окна просмотра <%lld px, а UA настольный — сайты могут отдавать мобильную вёрстку, которая отображается некорректно. Рекомендуется переключить UA на мобильный."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视口宽度小于 %lldpx，但 UA 为桌面版，网站可能会返回显示别扭的移动版布局。建议将 UA 切换为移动版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視區寬度小於 %lldpx，但 UA 為桌面版，網站可能會回傳顯示不佳的行動版版面。建議將 UA 切換為行動版。"
          }
        }
      }
    },
    "Viewport ≥%lldpx while UA is Mobile — sites may serve a desktop layout that renders awkwardly. Consider switching UA to Desktop." : {
      "comment" : "Browser settings warning banner; the argument is the width breakpoint in pixels",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viewport mindestens %lld px breit, aber UA ist Mobil – Websites liefern evtl. ein Desktop-Layout, das seltsam aussieht. Wechsle den UA ggf. zu Desktop."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viewport ≥%lldpx while UA is Mobile — sites may serve a desktop layout that renders awkwardly. Consider switching UA to Desktop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenêtre d’affichage ≥ %lld px alors que le User-Agent est de type mobile : les sites risquent de servir une mise en page pour ordinateur mal affichée. Envisagez de passer le User-Agent en mode ordinateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビューポートの幅が %lldpx 以上ですが UA がモバイル版のため、Web サイトが表示の崩れたデスクトップ版レイアウトを返す可能性があります。UA をデスクトップ版に切り替えることをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UA가 모바일인데 뷰포트가 %lldpx 이상이에요. 웹 사이트가 어색하게 보이는 데스크톱 레이아웃을 제공할 수 있으니 UA를 데스크톱으로 전환해 보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ширина окна просмотра ≥%lld px, а UA мобильный — сайты могут отдавать настольную вёрстку, которая отображается некорректно. Рекомендуется переключить UA на настольный."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视口宽度不小于 %lldpx，但 UA 为移动版，网站可能会返回显示别扭的桌面版布局。建议将 UA 切换为桌面版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視區寬度不小於 %lldpx，但 UA 為行動版，網站可能會回傳顯示不佳的桌面版版面。建議將 UA 切換為桌面版。"
          }
        }
      }
    },

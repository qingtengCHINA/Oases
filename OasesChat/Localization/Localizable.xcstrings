            "value" : "When off, the iSH shell and AI tools cannot create, edit, or delete files in this mount."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est désactivée, le shell iSH et les outils d’IA ne peuvent pas créer, modifier ni supprimer de fichiers dans ce point de montage."

    },
    "This will delete the entire rootfs. All data will be lost. The app will need to restart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird das gesamte rootfs gelöscht. Alle Daten gehen verloren und die App muss neu gestartet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete the entire rootfs. All data will be lost. The app will need to restart."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rootfs entier sera supprimé. Toutes les données seront perdues. L’app devra redémarrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rootfs 全体を削除します。すべてのデータが失われ、アプリの再起動が必要になります。"
          }
        },
        "ko" : {
          "stringUnit" : {

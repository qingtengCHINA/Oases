          }
        }
      }
    },
    "A voice service is configured more than once. Voice is merged into a single row here; you can delete the extra provider above if you want." : {
      "comment" : "Duplicate voice provider hint",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Sprachdienst ist mehrfach konfiguriert. Er wurde hier zu einer Zeile zusammengeführt. Bei Bedarf kannst du den überzähligen Anbieter oben löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A voice service is configured more than once. Voice is merged into a single row here; you can delete the extra provider above if you want."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un service vocal est configuré plusieurs fois. La voix est regroupée ici sur une seule ligne ; vous pouvez supprimer le fournisseur en trop ci-dessus si besoin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声サービスが重複して設定されています。ここでは音声を 1 行にまとめています。必要に応じて、上にある余分なプロバイダを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 서비스가 중복으로 구성되어 있어요. 여기서는 음성을 한 행으로 합쳤으며, 필요하면 위에서 중복된 제공업체를 삭제할 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовой сервис настроен несколько раз. Здесь голос объединён в одну строку; при желании удалите лишнего провайдера выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有语音服务被重复配置。这里已将语音合并为一行，如有需要，可以删除上方多余的供应商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有語音服務重複設定。這裡已將語音合併為一列，如有需要，可以刪除上方多餘的供應商。"
          }
        }

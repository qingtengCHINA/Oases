            "value" : "단축어로 실행된 작업을 포함하여 에이전트 작업이 시작되고 완료될 때 로컬 알림을 표시해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать локальные уведомления при запуске и завершении задач агента, в том числе запущенных из быстрых команд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 任务开始和完成时显示本地通知，包括由快捷指令触发的任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 任務開始和完成時顯示本機通知，包括由捷徑觸發的任務。"
          }
        }
      }
    },

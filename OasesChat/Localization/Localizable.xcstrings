    "This tool may have been paused by the system while running in the background. Enable enhanced background execution to improve background task reliability." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Werkzeug wurde im Hintergrund möglicherweise vom System pausiert. Aktiviere die erweiterte Hintergrundausführung, um Hintergrundaufgaben zuverlässiger zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This tool may have been paused by the system while running in the background. Enable enhanced background execution to improve background task reliability."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet outil a peut-être été suspendu par le système pendant son exécution en arrière-plan. Activez l’exécution en arrière-plan renforcée pour améliorer la fiabilité des tâches en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このツールはバックグラウンドでの実行中にシステムによって一時停止された可能性があります。「バックグラウンド実行の強化」をオンにすると、バックグラウンドタスクの信頼性が向上します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드에서 실행되는 동안 시스템이 이 도구를 일시 중단했을 수 있어요. 향상된 백그라운드 실행을 켜면 백그라운드 작업의 안정성이 높아져요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, система приостановила этот инструмент во время работы в фоне. Включите расширенную фоновую работу, чтобы фоновые задачи выполнялись надёжнее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工具在后台运行时可能已被系统暂停。开启增强后台运行可以提高后台任务的可靠性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工具在背景執行時可能已被系統暫停。開啟增強背景執行可以提高背景任務的可靠性。"
          }
        }
      }
    },
    "This voice service shares the API key and endpoint of its provider. To change them, edit that provider." : {
      "comment" : "Shadow voice provenance note",
      "localizations" : {
        "de" : {
          "stringUnit" : {

          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses /v1/responses endpoint format. Required for some Responses-API-only services."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le format de point de terminaison /v1/responses. Requis pour certains services qui ne prennent en charge que la Responses API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/v1/responses エンドポイント形式を使用します。Responses API のみに対応した一部のサービスで必要です。"

          }
        }
      }
    },
    "Leave empty to use the default endpoint. \"/v1\" is appended automatically — enter the base host only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um den Standard-Endpunkt zu nutzen. „/v1“ wird automatisch angehängt – gib nur die Hostadresse ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave empty to use the default endpoint. \"/v1\" is appended automatically — enter the base host only."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour utiliser le point de terminaison par défaut. « /v1 » est ajouté automatiquement : saisissez uniquement l’hôte de base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄の場合はデフォルトのエンドポイントを使用します。「/v1」は自動的に追加されるため、ホストのみを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비워 두면 기본 엔드포인트를 사용해요. ‘/v1’은 자동으로 추가되니 호스트 주소만 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым, чтобы использовать эндпоинт по умолчанию. «/v1» добавляется автоматически — укажите только адрес хоста."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则使用默认端点。系统会自动追加 /v1，只需填写主机地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空則使用預設端點。系統會自動附加 /v1，只需填寫主機位址。"
          }
        }
      }
    },
    "Leave empty to use the default Google endpoint. Enter the full base URL including version path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {

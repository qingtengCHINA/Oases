    "Bind this session to a group for automatic fallback or load balancing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binde diesen Chat an eine Gruppe, um automatisch auf Ersatzmodelle auszuweichen oder die Last zu verteilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bind this session to a group for automatic fallback or load balancing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liez cette conversation à un groupe pour activer le basculement automatique ou la répartition de charge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットをグループに関連付けると、予備モデルへの自動切り替えや負荷分散を行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화를 그룹에 연결하여 자동 대체 또는 부하 분산을 사용하세요."

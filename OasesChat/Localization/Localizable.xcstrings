          }
        }
      }
    },
    "Response ended incomplete (reason: %@) — output hit max_output_tokens; raise the model's Max Output Tokens or shorten the request." : {
      "comment" : "Chat error: the reply was cut off by the output token limit; argument is the API's reason code",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwort unvollständig beendet (Grund: %@) – die Ausgabe hat max_output_tokens erreicht. Erhöhe die maximalen Ausgabe-Token des Modells oder kürze die Anfrage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Response ended incomplete (reason: %@) — output hit max_output_tokens; raise the model's Max Output Tokens or shorten the request."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponse incomplète (motif : %@) : la sortie a atteint la limite max_output_tokens. Augmentez les tokens de sortie max du modèle ou raccourcissez la requête."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応答が途中で終了しました（理由：%@）：出力が max_output_tokens の上限に達しました。モデルの最大出力トークンを増やすか、リクエストを短くしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답이 완전히 끝나지 않았어요(이유: %@). 출력이 max_output_tokens 한도에 도달했어요. 모델의 최대 출력 토큰을 늘리거나 요청을 줄이세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответ завершился не полностью (причина: %@) — вывод достиг лимита max_output_tokens. Увеличьте «Макс. выходных токенов» для модели или сократите запрос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回复未完整结束（原因：%@）：输出达到 max_output_tokens 上限。请调高模型的最大输出 token，或缩短请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回覆未完整結束（原因：%@）：輸出達到 max_output_tokens 上限。請調高模型的最大輸出 token，或縮短請求。"
          }
        }
      }
    },

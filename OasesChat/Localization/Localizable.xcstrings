          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Local tool results were kept. Check the endpoint, API Key, or quota of the engineering mode AI provider."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Les résultats des outils locaux ont été conservés. Vérifiez le point de terminaison, l’API Key ou le quota du fournisseur d’IA du mode ingénierie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ローカルツールの結果は保持されています。エンジニアリングモードの AI プロバイダのエンドポイント、API Key、または利用枠を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {

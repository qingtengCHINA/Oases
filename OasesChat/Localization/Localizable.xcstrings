    "This JSON file looks like an exported provider configuration. Import it as a new provider, or add it to the chat as a file attachment?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese JSON-Datei sieht wie eine exportierte Anbieterkonfiguration aus. Als neuen Anbieter importieren oder als Dateianhang zum Chat hinzufügen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This JSON file looks like an exported provider configuration. Import it as a new provider, or add it to the chat as a file attachment?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier JSON semble être une configuration de fournisseur exportée. L’importer comme nouveau fournisseur, ou l’ajouter à la conversation comme pièce jointe ?"
          }

      }
    },
    "Persistent instructions and preferences visible to the agent in every session. You can edit it here, or just ask the agent to help organize and update this memory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauerhafte Anweisungen und Vorlieben, die der Agent in jedem Chat sieht. Du kannst sie hier bearbeiten oder den Agenten bitten, dieses Gedächtnis für dich zu ordnen und zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persistent instructions and preferences visible to the agent in every session. You can edit it here, or just ask the agent to help organize and update this memory."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instructions et préférences permanentes visibles par l’agent dans chaque conversation. Vous pouvez les modifier ici, ou simplement demander à l’agent de vous aider à organiser et mettre à jour cette mémoire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのチャットでエージェントが参照する、継続的な指示や好みです。ここで編集することも、エージェントにこのメモリの整理や更新を頼むこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 모든 대화에서 참고하는 장기 지침과 선호 사항이에요. 여기에서 직접 편집하거나, 에이전트에게 이 메모리를 정리하고 업데이트해 달라고 요청할 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постоянные инструкции и предпочтения, которые агент видит в каждом чате. Их можно изменить здесь или попросить агента упорядочить и обновить эту память."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每个会话中 Agent 都能看到的长期指令和偏好。你可以在这里编辑，也可以直接让 Agent 帮你整理和更新这份记忆。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每個對話中 Agent 都能看到的長期指令和偏好。你可以在這裡編輯，也可以直接讓 Agent 幫你整理和更新這份記憶。"
          }
        }
      }
    },

    },
    "下午好。困了吗？我扶你一把。" : {
      "comment" : "Empty-state greeting, afternoon (14–19h)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Nachmittag. Müde? Ich helfe dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good afternoon. Feeling sleepy? I’ve got you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon après-midi. Un coup de fatigue ? Je suis là."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは。眠くなってきましたか？お手伝いします。"

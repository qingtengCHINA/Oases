    "Images, videos, or files to replace existing attachments. Accepts output from previous Shortcuts actions. If empty, keeps original attachments." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder, Videos oder Dateien, die vorhandene Anhänge ersetzen. Akzeptiert die Ausgabe vorheriger Kurzbefehl-Aktionen. Leer lassen, um die ursprünglichen Anhänge zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images, videos, or files to replace existing attachments. Accepts output from previous Shortcuts actions. If empty, keeps original attachments."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images, vidéos ou fichiers qui remplaceront les pièces jointes existantes. Accepte la sortie d’actions de raccourci précédentes. Si ce champ est vide, les pièces jointes d’origine sont conservées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存の添付ファイルと置き換える画像、ビデオ、またはファイル。前のショートカットアクションの出力を受け取れます。空の場合は元の添付ファイルを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {

    "Leave Context Window empty to use auto-detected value. Leave Max Output Tokens empty to follow the provider default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontextfenster leer lassen, um den automatisch erkannten Wert zu nutzen. Maximale Ausgabe-Token leer lassen, um den Standard des Anbieters zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave Context Window empty to use auto-detected value. Leave Max Output Tokens empty to follow the provider default."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez « Fenêtre de contexte » vide pour utiliser la valeur détectée automatiquement. Laissez « Tokens de sortie max » vide pour suivre la valeur par défaut du fournisseur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストウインドウを空欄にすると自動検出された値を使用します。最大出力トークンを空欄にするとプロバイダのデフォルト値に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트 윈도우를 비워 두면 자동 감지된 값을 사용하고, 최대 출력 토큰을 비워 두면 제공업체 기본값을 따라요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте «Окно контекста» пустым, чтобы использовать автоматически определённое значение. Оставьте «Макс. выходных токенов» пустым, чтобы использовать значение провайдера по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文窗口留空则使用自动检测的值；最大输出 token 留空则沿用供应商默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文視窗留空則使用自動偵測的值；最大輸出 token 留空則沿用供應商預設值。"
          }
        }
      }
    },
    "Leave display name empty to use the model ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzeigename leer lassen, um die Modell-ID zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave display name empty to use the model ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le nom d’affichage vide pour utiliser l’ID du modèle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示名を空欄にするとモデル ID を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시 이름을 비워 두면 모델 ID를 사용해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

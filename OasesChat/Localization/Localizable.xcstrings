    "This reply couldn't be saved. Free up some storage, or it will be missing when you reopen the conversation." : {
      "comment" : "Agent chat: a message failed to be written to the local database (usually a full disk)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Antwort konnte nicht gespeichert werden. Gib etwas Speicherplatz frei, sonst fehlt sie, wenn du die Unterhaltung wieder öffnest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This reply couldn't be saved. Free up some storage, or it will be missing when you reopen the conversation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette réponse n’a pas pu être enregistrée. Libérez de l’espace, sinon elle aura disparu quand vous rouvrirez la conversation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この返信を保存できませんでした。空き容量を増やしてください。そうしないと、会話を開き直したときに表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 답변을 저장하지 못했어요. 저장 공간을 확보하지 않으면 대화를 다시 열 때 사라져요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить этот ответ. Освободите место, иначе при повторном открытии разговора его не будет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条回复没能保存。请释放一些存储空间，否则重新打开对话时它会消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這則回覆沒能儲存。請釋放一些儲存空間，否則重新打開對話時它會消失。"
          }
        }
      }
    },

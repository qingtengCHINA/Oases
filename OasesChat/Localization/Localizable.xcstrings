    "Re-runs the AI agent from a specific user message in a session. Presents a list of user messages to choose from, then retries from that point." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt den KI-Agenten ab einer bestimmten Nutzernachricht in einem Chat erneut aus. Zeigt eine Liste von Nutzernachrichten zur Auswahl und wiederholt dann ab dieser Stelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-runs the AI agent from a specific user message in a session. Presents a list of user messages to choose from, then retries from that point."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relance l’agent IA à partir d’un message utilisateur précis dans une conversation. Présente la liste des messages utilisateur à choisir, puis relance à partir de ce point."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャット内の特定のユーザメッセージから AI エージェントを再実行します。ユーザメッセージの一覧から選択すると、その時点から再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화의 특정 사용자 메시지부터 AI 에이전트를 다시 실행해요. 사용자 메시지 목록에서 하나를 선택하면 그 지점부터 다시 시도해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапускает ИИ-агента с определённого сообщения пользователя в чате. Показывает список сообщений пользователя для выбора и повторяет с выбранного места."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从会话中的某条用户消息开始重新运行 AI Agent。会先列出用户消息供你选择，然后从该处重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從對話中的某則使用者訊息開始重新執行 AI Agent。會先列出使用者訊息供你選擇，然後從該處重試。"
          }
        }
      }
    },

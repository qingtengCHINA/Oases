          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in skills ship with the app and can’t be deleted, but you can turn them off at any time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les compétences intégrées sont fournies avec l’app et ne peuvent pas être supprimées, mais vous pouvez les désactiver à tout moment."
          }
        },
        "ja" : {
          "stringUnit" : {

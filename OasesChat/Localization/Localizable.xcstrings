    "Enables background audio playback for text-to-speech narration and music/audio playback while the app is in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht die Wiedergabe von Vorlesen und Musik/Audio, während die App im Hintergrund ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enables background audio playback for text-to-speech narration and music/audio playback while the app is in the background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet de poursuivre la lecture à voix haute et la lecture de musique ou d’audio lorsque l’app est en arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがバックグラウンドにあるときも、音声読み上げや音楽/オーディオの再生を続けられるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 백그라운드에 있을 때도 소리 내어 읽기와 음악/오디오를 계속 재생할 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет продолжать чтение вслух и воспроизведение музыки и аудио, когда приложение работает в фоне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许在 App 进入后台时继续播放语音朗读和音乐/音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許在 App 進入背景時繼續播放語音朗讀和音樂/音訊。"
          }
        }
      }
    },

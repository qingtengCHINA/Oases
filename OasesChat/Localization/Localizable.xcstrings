    "%@ 本机工具结果已保留；工程执行层仍在本机，请稍后重试模型请求。" : {
      "comment" : "%@ is the preceding error sentence",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Lokale Werkzeugergebnisse wurden beibehalten. Die Engineering-Laufzeit läuft weiter auf diesem Gerät. Versuche die Modellanfrage später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Local tool results were kept. The engineering runtime is still on this device; try the model request again later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Les résultats des outils locaux ont été conservés. L’environnement d’exécution d’ingénierie est toujours sur cet appareil ; réessayez la requête au modèle plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ローカルツールの結果は保持されています。エンジニアリング実行環境はこのデバイス上にあります。しばらくしてからモデルへのリクエストを再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 로컬 도구 결과는 유지되었어요. 엔지니어링 실행 환경은 아직 이 기기에 있으니 잠시 후 모델 요청을 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Локальные результаты инструментов сохранены. Среда выполнения по-прежнему на этом устройстве; повторите запрос к модели позже."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 本機工具結果已保留；工程執行層仍在本機，請稍後重試模型請求。"
          }
        }
      }
    },
    "%@ 本机工具结果已保留；请检查工程模式 AI Provider 的 endpoint、API Key 或额度。" : {
      "comment" : "%@ is the preceding error sentence",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

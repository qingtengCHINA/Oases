      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis du erneut zustimmst, wird nichts an KI-Dienste gesendet. Chats und Einstellungen auf diesem Gerät bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing will be sent to AI services until you agree again. Chats and settings on this device stay as they are."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne sera envoyé aux services d’IA tant que vous n’aurez pas accepté à nouveau. Les conversations et réglages de cet appareil restent inchangés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再び同意するまで、AI サービスには何も送信されません。このデバイスのチャットや設定はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 동의하기 전까지 AI 서비스로 아무것도 보내지 않아요. 이 기기의 대화와 설정은 그대로 유지돼요."

        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le bouton accolades pour insérer une référence à une variable d’environnement de l’app sous la forme $$NAME. Sa valeur est renseignée à l’exécution."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波かっこボタンを使うと、アプリの環境変数への参照を $$NAME の形式で挿入できます。値は実行時に入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중괄호 버튼을 사용하여 앱 환경 변수 참조를 $$NAME 형식으로 삽입하세요. 값은 실행 시 채워져요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка с фигурными скобками вставляет ссылку на переменную окружения приложения в виде $$NAME. Её значение подставляется во время выполнения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用花括号按钮插入 App 环境变量引用，格式为 $$NAME，其值会在运行时填入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用大括號按鈕插入 App 環境變數參照，格式為 $$NAME，其值會在執行時填入。"
          }
        }
      }
    },

    "When off, the iSH shell and AI tools cannot create, edit, or delete files in this mount." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, können die iSH-Shell und KI-Werkzeuge in dieser Einbindung keine Dateien erstellen, bearbeiten oder löschen."

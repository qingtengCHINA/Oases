    "A Shortcut sent to Oases Chat may not have finished. Open the session to check." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein an Oases Chat gesendeter Kurzbefehl ist möglicherweise nicht abgeschlossen. Öffne den Chat, um nachzusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Shortcut sent to Oases Chat may not have finished. Open the session to check."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un raccourci envoyé à Oases Chat n’a peut-être pas abouti. Ouvrez la conversation pour vérifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oases Chat に送信したショートカットが完了していない可能性があります。チャットを開いて確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oases Chat으로 보낸 단축어가 완료되지 않았을 수 있어요. 대화를 열어 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрая команда, отправленная в Oases Chat, возможно, не завершилась. Откройте чат, чтобы проверить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送到 Oases Chat 的快捷指令可能尚未完成，请打开会话查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送到 Oases Chat 的捷徑可能尚未完成，請開啟對話查看。"
          }
        }
      }
    },
    "A task is running in this chat. Starting a new chat will stop it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Chat läuft eine Aufgabe. Ein neuer Chat stoppt sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A task is running in this chat. Starting a new chat will stop it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une tâche est en cours dans cette conversation. Démarrer une nouvelle conversation l’arrêtera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットでタスクが実行中です。新しいチャットを開始するとタスクは停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화에서 작업이 실행 중이에요. 새 대화를 시작하면 작업이 중지돼요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

    "Use a static bearer token instead of the OAuth sign-in flow. Useful with custom proxy endpoints." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein festes Bearer-Token statt der OAuth-Anmeldung verwenden. Nützlich für eigene Proxy-Endpunkte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a static bearer token instead of the OAuth sign-in flow. Useful with custom proxy endpoints."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser un jeton Bearer fixe au lieu du flux de connexion OAuth. Utile avec des points de terminaison proxy personnalisés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuth のサインインフローの代わりに固定の Bearer トークンを使用します。カスタムのプロキシエンドポイントで役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuth 로그인 흐름 대신 고정 Bearer 토큰을 사용해요. 사용자 지정 프록시 엔드포인트에 유용해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать постоянный токен Bearer вместо входа через OAuth. Полезно для собственных прокси-эндпоинтов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用固定的 Bearer 令牌代替 OAuth 登录流程，适用于自定义代理端点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用固定的 Bearer 權杖取代 OAuth 登入流程，適用於自訂代理端點。"
          }
        }
      }
    },

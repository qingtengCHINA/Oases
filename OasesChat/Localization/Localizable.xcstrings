    "Wait for the reply and return it. Turn off to return immediately and get a notification when done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf die Antwort warten und sie zurückgeben. Ausschalten, um sofort zurückzukehren und bei Abschluss eine Mitteilung zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for the reply and return it. Turn off to return immediately and get a notification when done."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendre la réponse et la renvoyer. Désactivez pour renvoyer immédiatement et recevoir une notification une fois terminé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信を待ってから結果を返します。オフにするとすぐに戻り、完了時に通知されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변을 기다렸다가 반환해요. 끄면 즉시 반환하고 완료되면 알림을 보내요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождаться ответа и вернуть его. Если выключить, команда завершится сразу, а по готовности придёт уведомление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待回复并返回结果。关闭后会立即返回，完成时再通知你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待回覆並回傳結果。關閉後會立即回傳，完成時再通知你。"
          }
        }
      }
    },

    "%@ · Moves to Recently Deleted. You can restore it within 30 days." : {
      "comment" : "File browser delete confirmation; argument is the item size",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Wird nach „Zuletzt gelöscht“ verschoben. Du kannst es 30 Tage lang wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Moves to Recently Deleted. You can restore it within 30 days."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Déplacé dans Supprimés récemment. Vous pourrez le restaurer pendant 30 jours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 「最近削除した項目」に移動します。30日以内なら復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 최근 삭제된 항목으로 이동해요. 30일 이내에 복구할 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · Будет перемещено в «Недавно удалённые». Восстановить можно в течение 30 дней."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 将移到「最近删除」，30 天内可以恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 將移到「最近刪除」，30 天內可以復原。"
          }
        }
      }
    },

    "These directories appear in iOS Files under On My iPhone → Oases Chat. Tap a row to see details, browse, or toggle visibility." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verzeichnisse erscheinen in der iOS-App „Dateien“ unter „Auf meinem iPhone“ → „Oases Chat“. Tippe auf eine Zeile, um Details zu sehen, sie zu durchsuchen oder die Sichtbarkeit umzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {

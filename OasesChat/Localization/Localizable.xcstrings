          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The path above is how iOS exposes the folder you picked. Use it to confirm which app this data belongs to."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chemin ci-dessus correspond à la façon dont iOS expose le dossier choisi. Utilisez-le pour vérifier à quelle app appartiennent ces données."

        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디렉터리는 iOS ‘파일’ 앱의 나의 iPhone > Oases Chat에 표시돼요. 행을 탭하여 세부 정보를 보거나, 둘러보거나, 표시 여부를 전환하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти каталоги отображаются в приложении «Файлы» iOS в разделе «На iPhone» → «Oases Chat». Коснитесь строки, чтобы посмотреть сведения, открыть каталог или изменить его видимость."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop the running task before clearing the chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez la tâche en cours avant d’effacer la conversation."
          }
        },
        "ja" : {

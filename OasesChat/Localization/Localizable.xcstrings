        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over limit: %1$lld / %2$lld tokens. Each CJK character and each Latin word counts as one."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite dépassée : %1$lld / %2$lld tokens. Chaque caractère CJK et chaque mot latin comptent pour un."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限を超えています：%1$lld / %2$lld トークン。CJK の 1 文字とラテン文字の 1 単語をそれぞれ 1 としてカウントします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도 초과: %1$lld / %2$lld 토큰. 한중일 문자 1자와 라틴 문자 단어 1개를 각각 1개로 계산해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превышен лимит токенов: %1$lld / %2$lld. Каждый символ CJK и каждое латинское слово считаются за один."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出上限：%1$lld / %2$lld token。每个中日韩字符和每个拉丁单词都计为 1 个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出上限：%1$lld / %2$lld token。每個中日韓字元和每個拉丁單字都計為 1 個。"
          }
        }
      }
    },
    "Override the User-Agent header sent to this endpoint. Leave empty to use the Oases default. Useful for relays that only accept specific clients (e.g. \"claude-cli/1.0\")." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überschreibt den User-Agent-Header, der an diesen Endpunkt gesendet wird. Leer lassen, um den Oases-Standard zu verwenden. Nützlich für Relays, die nur bestimmte Clients akzeptieren (z. B. „claude-cli/1.0“)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Override the User-Agent header sent to this endpoint. Leave empty to use the Oases default. Useful for relays that only accept specific clients (e.g. \"claude-cli/1.0\")."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace l’en-tête User-Agent envoyé à ce point de terminaison. Laissez vide pour utiliser la valeur par défaut d’Oases. Utile pour les relais qui n’acceptent que certains clients (p. ex. « claude-cli/1.0 »)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンドポイントに送信する User-Agent ヘッダを上書きします。空欄の場合は Oases のデフォルト値を使用します。特定のクライアントのみを受け付ける中継サービス（例：「claude-cli/1.0」）で役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 엔드포인트로 전송되는 User-Agent 헤더를 재정의해요. 비워 두면 Oases 기본값을 사용해요. 특정 클라이언트만 허용하는 중계 서비스에 유용해요(예: “claude-cli/1.0”)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переопределяет заголовок User-Agent, отправляемый на этот эндпоинт. Оставьте пустым, чтобы использовать значение Oases по умолчанию. Полезно для ретрансляторов, которые принимают только определённых клиентов (например, «claude-cli/1.0»)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖发送到此端点的 User-Agent 请求头。留空则使用 Oases 默认值。适用于只接受特定客户端的中转服务（例如“claude-cli/1.0”）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆寫傳送到此端點的 User-Agent 請求標頭。留空則使用 Oases 預設值。適用於只接受特定用戶端的中繼服務（例如「claude-cli/1.0」）。"
          }
        }
      }
    },

        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/v1/responses 엔드포인트 형식을 사용해요. Responses API만 지원하는 일부 서비스에 필요해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует формат эндпоинта /v1/responses. Требуется для некоторых сервисов, поддерживающих только Responses API."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

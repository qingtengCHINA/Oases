    "The provider has not declared whether this model supports thinking. Force-enabling may cause errors — you can disable it or retry if needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anbieter hat nicht angegeben, ob dieses Modell Denken unterstützt. Erzwingen kann zu Fehlern führen – bei Bedarf kannst du es deaktivieren oder es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The provider has not declared whether this model supports thinking. Force-enabling may cause errors — you can disable it or retry if needed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur n’a pas indiqué si ce modèle prend en charge la réflexion. Forcer son activation peut provoquer des erreurs : vous pouvez la désactiver ou réessayer si nécessaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルが思考に対応しているかどうかをプロバイダが示していません。強制的にオンにするとエラーが発生する場合があります。必要に応じてオフにするか、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제공업체가 이 모델의 사고 지원 여부를 밝히지 않았어요. 강제로 켜면 오류가 발생할 수 있으니 필요하면 끄거나 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер не указал, поддерживает ли эта модель размышление. Принудительное включение может вызывать ошибки — при необходимости отключите его или повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供应商未声明此模型是否支持思考。强制开启可能导致出错，如有需要可以关闭或重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供應商未聲明此模型是否支援思考。強制開啟可能導致出錯，如有需要可以關閉或重試。"
          }
        }
      }
    },

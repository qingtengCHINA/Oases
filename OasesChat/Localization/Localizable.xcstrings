    "Images, videos, or files to attach to the prompt. Accepts output from previous Shortcuts actions (e.g. filtered photos or documents)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder, Videos oder Dateien, die an den Prompt angehängt werden. Akzeptiert die Ausgabe vorheriger Kurzbefehl-Aktionen (z. B. gefilterte Fotos oder Dokumente)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images, videos, or files to attach to the prompt. Accepts output from previous Shortcuts actions (e.g. filtered photos or documents)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images, vidéos ou fichiers à joindre au prompt. Accepte la sortie d’actions de raccourci précédentes (p. ex. photos filtrées ou documents)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトに添付する画像、ビデオ、またはファイル。前のショートカットアクションの出力（絞り込んだ写真や書類など）を受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트에 첨부할 이미지, 비디오 또는 파일이에요. 이전 단축어 동작의 출력(예: 필터링된 사진이나 문서)을 받을 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображения, видео или файлы для вложения в запрос. Принимает результат предыдущих действий быстрых команд (например, отобранные фото или документы)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要附加到提示词的图片、视频或文件。可接收前面快捷指令操作的输出（例如筛选后的照片或文稿）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要附加到提示詞的圖片、影片或檔案。可接收前面捷徑動作的輸出（例如篩選後的照片或文件）。"
          }
        }
      }
    },

    "NFCReaderUsageDescription" : {
      "comment" : "Permission prompt: NFC",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent liest oder beschreibt NFC-Tags, wenn du ihn darum bittest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent reads or writes NFC tags when you ask it to."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent lit ou écrit des étiquettes NFC lorsque vous le lui demandez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依頼に応じて、エージェントが NFC タグの内容を読み書きします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하면 에이전트가 NFC 태그를 읽거나 써요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент читает или записывает NFC-метки по вашему запросу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 在你请求时读取或写入 NFC 标签内容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 會在你要求時讀取或寫入 NFC 標籤內容"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Permission prompt: Apple Music / media library",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent liest die Musikmediathek auf diesem Gerät, um Fragen zur Wiedergabe zu beantworten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent reads the music library on this device to answer questions about playback."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent lit la bibliothèque musicale de cet appareil pour répondre à vos questions sur la lecture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生に関する質問に答えるため、エージェントがこのデバイスのミュージックライブラリを読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 관련 질문에 답하기 위해 에이전트가 이 기기의 음악 보관함을 읽어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент читает медиатеку на этом устройстве, чтобы отвечать на вопросы о воспроизведении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 读取本机音乐资料库以回答播放相关问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 會讀取本機音樂資料庫以回答播放相關問題"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Permission prompt: Bluetooth",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent sucht nach Bluetooth-Zubehör und verbindet sich damit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent scans for and connects to Bluetooth accessories."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent recherche des accessoires Bluetooth et s’y connecte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが Bluetooth アクセサリをスキャンして接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 Bluetooth 액세서리를 검색하고 연결해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент ищет Bluetooth-аксессуары и подключается к ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 扫描并连接蓝牙外设"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 會掃描並連接藍牙配件"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Permission prompt: calendars (full access)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent liest Kalenderereignisse, um Fragen zu deinen Terminen zu beantworten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent reads calendar events to answer questions about your schedule."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent lit les événements du calendrier pour répondre à vos questions sur votre emploi du temps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定に関する質問に答えるため、エージェントがカレンダーのイベントを読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일정 관련 질문에 답하기 위해 에이전트가 캘린더 이벤트를 읽어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент читает события календаря, чтобы отвечать на вопросы о вашем расписании."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 读取日历事件以回答日程问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 會讀取行事曆活動以回答行程問題"
          }
        }
      }
    },

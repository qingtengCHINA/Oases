    "NSCameraUsageDescription" : {
      "comment" : "Permission prompt: camera",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um Fotos aufzunehmen und als Anhänge zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to take photos and send them as attachments."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à prendre des photos et à les envoyer en pièce jointe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を撮影して添付ファイルとして送信するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 찍어 첨부 파일로 보내는 데 사용해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется, чтобы делать фото и отправлять их как вложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于拍照后作为附件发送"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於拍照後作為附件傳送"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Permission prompt: contacts",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent sucht Kontakte anhand ihres Namens."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent looks up contacts by name."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent recherche des contacts par nom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが名前で連絡先を検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 이름으로 연락처를 찾아요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент ищет контакты по имени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 按名字查找联系人"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 會依名字查找聯絡人"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Permission prompt: Face ID",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um Oases Chat mit Face ID zu entsperren, nachdem du den Chatschutz aktiviert hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to unlock Oases Chat with Face ID after you turn on chat protection."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à déverrouiller Oases Chat avec Face ID une fois la protection des conversations activée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットの保護をオンにしたあと、Face ID で Oases Chat のロックを解除するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화 보호를 켠 후 Face ID로 Oases Chat의 잠금을 해제하는 데 사용해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для разблокировки Oases Chat с помощью Face ID после включения защиты чатов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在你开启对话保护后，通过面容 ID 解锁 Oases Chat"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於在你開啟對話保護後，透過 Face ID 解鎖 Oases Chat"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Permission prompt: local network",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um eine Verbindung zu MCP-Servern, Modelldiensten oder Webseiten herzustellen, die du in deinem lokalen Netzwerk eingerichtet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to connect to MCP servers, model services, or web pages you set up on your local network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à se connecter aux serveurs MCP, services de modèles ou pages web que vous avez configurés sur votre réseau local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワーク上に設定した MCP サーバ、モデルサービス、Web ページに接続するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 네트워크에 설정한 MCP 서버, 모델 서비스 또는 웹 페이지에 연결하는 데 사용해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для подключения к серверам MCP, сервисам моделей или веб-страницам, настроенным вами в локальной сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于连接你在局域网中配置的 MCP 服务器、模型服务或网页"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於連接你在區域網路中設定的 MCP 伺服器、模型服務或網頁"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Permission prompt: location while in use",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent ruft deinen aktuellen Standort ab, um Fragen zu beantworten, die ihn erfordern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent gets your current location to answer questions that need it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent obtient votre position actuelle pour répondre aux questions qui en ont besoin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地が必要な質問に答えるため、エージェントが現在地を取得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치가 필요한 질문에 답하기 위해 에이전트가 현재 위치를 가져와요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент определяет ваше текущее местоположение, чтобы отвечать на вопросы, где оно нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 获取当前位置以回答相关问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 會取得目前位置以回答相關問題"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission prompt: microphone",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für Spracheingabe, Vorlesen und das Aufnehmen von Besprechungen verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used for voice input, read-aloud and recording meetings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à la saisie vocale, à la lecture à voix haute et à l’enregistrement des réunions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力、読み上げ、会議の録音に使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 입력, 소리 내어 읽기, 회의 녹음에 사용해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для голосового ввода, чтения вслух и записи встреч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于语音输入、朗读和会议录音"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於語音輸入、朗讀和會議錄音"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Permission prompt: add to photo library",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um erzeugte Bilder und die QingTeng-Kontokarte in deiner Fotomediathek zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to save generated images and your QingTeng account card to your photo library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à enregistrer les images générées et votre carte de compte QingTeng dans votre photothèque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

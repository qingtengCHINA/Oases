#!/bin/sh
# ogent-need — make commands / Alpine packages available, installing only
# what is actually missing. Everything installed persists in the Ogent rootfs
# across commands, sessions and app launches, so never reinstall "to be sure".
#
#   ogent-need ffmpeg yt-dlp python3     # command names or apk package names
#   ogent-need py3-numpy                 # Python libs: prefer Alpine py3-* packages
#   ogent-need --list                    # show what is preinstalled
#   ogent-need --restore                 # reinstall packages the previous rootfs had
#
# Uses /etc/apk/repositories first; if that fails (slow/blocked network) it
# retries through fast mirrors without changing the configured default.

MIRRORS="https://mirrors.aliyun.com/alpine https://mirrors.tuna.tsinghua.edu.cn/alpine https://mirrors.ustc.edu.cn/alpine https://dl-cdn.alpinelinux.org/alpine"
PREVIOUS_WORLD=/root/.ogent/rootfs-profiles/previous-world.txt
COMMON="curl wget git jq openssl bash zip unzip file sqlite3 python3 pip3 uv ffmpeg ffprobe yt-dlp"

pkg_for() {
    case "$1" in
        python) echo python3 ;;
        pip|pip3) echo py3-pip ;;
        yt-dlp|youtube-dl) echo yt-dlp-core ;;
        ffprobe|ffplay) echo ffmpeg ;;
        uvx) echo uv ;;
        node) echo nodejs ;;
        npx) echo npm ;;
        sqlite3) echo sqlite ;;
        convert|magick|identify|mogrify) echo imagemagick ;;
        gcc|cc|make|g++|c++) echo build-base ;;
        7z) echo 7zip ;;
        unxz|xzcat) echo xz ;;
        dig|nslookup|host) echo bind-tools ;;
        ssh|scp|sftp) echo openssh-client ;;
        *) echo "$1" ;;
    esac
}

list_tools() {
    echo "Preinstalled in the Ogent rootfs (persistent):"
    for c in $COMMON; do
        if p=$(command -v "$c" 2>/dev/null); then echo "  ok   $c ($p)"; else echo "  --   $c"; fi
    done
    echo "Python modules:"
    python3 - <<'PY' 2>/dev/null || echo "  python3 unavailable"
import importlib.util
for m in ["requests", "httpx", "aiohttp", "websockets", "PIL", "Crypto", "bs4", "lxml", "yaml", "brotli", "mutagen", "qrcode", "dateutil", "tabulate", "yt_dlp"]:
    print(("  ok   " if importlib.util.find_spec(m) else "  --   ") + m)
PY
    [ -s "$PREVIOUS_WORLD" ] && echo "Packages from the previous rootfs (ogent-need --restore): $(grep -v '^#' "$PREVIOUS_WORLD" | tr '\n' ' ')"
    return 0
}

apk_branch() {
    b=$(sed -n 's|.*/\(v[0-9][0-9.]*\)/main.*|\1|p' /etc/apk/repositories 2>/dev/null | head -n 1)
    echo "${b:-v3.21}"
}

install_pkgs() {
    # Cached index first (fast, offline-friendly), then a fresh index.
    apk add --quiet "$@" 2>/dev/null && return 0
    apk add --update-cache "$@" && return 0
    branch=$(apk_branch)
    repos=/tmp/ogent-need-repos.$$
    for mirror in $MIRRORS; do
        printf '%s/%s/main\n%s/%s/community\n' "$mirror" "$branch" "$mirror" "$branch" > "$repos"
        echo "ogent-need: retrying via $mirror" >&2
        if apk --repositories-file "$repos" add --update-cache "$@"; then
            rm -f "$repos"
            return 0
        fi
    done
    rm -f "$repos"
    return 1
}

case "${1:-}" in
    ""|-h|--help)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
        exit 0 ;;
    --list)
        list_tools
        exit 0 ;;
    --restore)
        [ -s "$PREVIOUS_WORLD" ] || { echo "ogent-need: nothing to restore"; exit 0; }
        set -- $(grep -v '^#' "$PREVIOUS_WORLD") ;;
esac

missing=""
for want in "$@"; do
    case "$want" in
        -*) continue ;;
        py3-*|lib*|*-dev|*-libs|*-doc) ;;
        *) command -v "$want" >/dev/null 2>&1 && continue ;;
    esac
    pkg=$(pkg_for "$want")
    apk info -e "$pkg" >/dev/null 2>&1 && continue
    case " $missing " in *" $pkg "*) ;; *) missing="$missing $pkg" ;; esac
done

if [ -z "$missing" ]; then
    echo "ogent-need: already available: $*"
    exit 0
fi

echo "ogent-need: installing:$missing"
# shellcheck disable=SC2086
if install_pkgs $missing; then
    echo "ogent-need: installed:$missing (persists; no need to install again)"
    exit 0
fi
echo "ogent-need: failed to install:$missing" >&2
exit 1

    "Toggles play/pause on Oases Chat audio narration from the Live Activity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet oder pausiert das Vorlesen von Oases Chat in der Live-Aktivität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toggles play/pause on Oases Chat audio narration from the Live Activity."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance ou met en pause la lecture à voix haute d’Oases Chat depuis l’activité en direct."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブアクティビティから Oases Chat の音声読み上げを再生または一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 현황에서 Oases Chat의 소리 내어 읽기를 재생하거나 일시 정지해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит или приостанавливает чтение вслух в Oases Chat из Live-активности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在实时活动中播放或暂停 Oases Chat 的语音朗读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在即時動態中播放或暫停 Oases Chat 的語音朗讀。"
          }
        }
      }

# Xcode user state
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# Build products
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
# SwiftPM build dirs inside vendored packages (e.g. vendor/spm/*/.build)
**/.build/

# Local tooling output (simulator screenshots, editor state)
.shots/
.zcode/

# Generated by XcodeGen — kept out of git; regenerate with `xcodegen generate`
OasesChat.xcodeproj/

# Swift Package Manager
.swiftpm/
Package.resolved

# CocoaPods (not used, but just in case)
Pods/

# macOS
.DS_Store
**/.DS_Store

# Secrets — generated from .env at build time, never committed.
# Only the template (.env.example) is tracked.
.env
.env.*
!.env.example
*.env
OasesChat/Generated/
**/secrets/

# Signing material and credentials: never in this repository.
*.p8
*.p12
*.pem.key
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
*.keystore
*.jks
id_rsa*
id_ed25519*

# The bundled Ogent rootfs is tracked verbatim (scripts/rootfs/build_alpine_fakefs.sh);
# the generic rules above (e.g. build/) must not drop files from it.
!OasesChat/Resources/AlpineFakefs/**
# SQLite sidecars appear whenever the bundled meta.db is inspected locally.
OasesChat/Resources/AlpineFakefs/meta.db-shm
OasesChat/Resources/AlpineFakefs/meta.db-wal
